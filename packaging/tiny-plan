#!/usr/bin/env python3
"""Generate a package build/runtime profile from the tiny-layer contract."""
import argparse
import json
import re
from pathlib import Path

CLASSES = {"required", "conditional", "excluded", "upstream-required"}
PACKAGES = {"systemd", "kea", "unbound", "hostapd", "jool"}


def scalar(value, line):
    value = value.strip()
    if not value:
        return {}
    if value.startswith(("[", "{")):
        try:
            return json.loads(value)
        except json.JSONDecodeError as exc:
            raise ValueError(f"line {line}: invalid JSON scalar") from exc
    if value in {"true", "false"}:
        return value == "true"
    if re.fullmatch(r"[0-9]+", value):
        return int(value)
    return value


def load_yaml(path):
    """Parse the deliberately small, data-only YAML subset used by tiny/."""
    entries = []
    for number, raw in enumerate(path.read_text().splitlines(), 1):
        text = raw.split("#", 1)[0].rstrip()
        if not text:
            continue
        indent = len(text) - len(text.lstrip(" "))
        if indent % 2 or "\t" in raw:
            raise ValueError(f"line {number}: use two-space indentation")
        entries.append((indent, text.strip(), number))

    def block(index, indent):
        if index >= len(entries) or entries[index][0] < indent:
            return {}, index
        is_list = entries[index][1].startswith("- ")
        result = [] if is_list else {}
        while index < len(entries) and entries[index][0] == indent:
            _, text, number = entries[index]
            if is_list:
                if not text.startswith("- "):
                    raise ValueError(f"line {number}: cannot mix list and map")
                result.append(scalar(text[2:], number))
                index += 1
                continue
            if text.startswith("- ") or ":" not in text:
                raise ValueError(f"line {number}: expected key: value")
            key, value = text.split(":", 1)
            if not key or key.strip() != key:
                raise ValueError(f"line {number}: invalid key")
            index += 1
            result[key] = scalar(value, number)
            if not value.strip() and index < len(entries) and entries[index][0] > indent:
                result[key], index = block(index, indent + 2)
        return result, index

    result, end = block(0, 0)
    if end != len(entries):
        raise ValueError("invalid indentation")
    return result


def capability_file(path, prefix):
    data = json.loads(Path(path).read_text())
    values = data.get("capabilities")
    if not isinstance(values, list) or not all(isinstance(v, str) for v in values):
        raise ValueError(f"{path}: expected JSON object with string capabilities array")
    if prefix and not all(v.startswith(prefix) for v in values):
        raise ValueError(f"{path}: capabilities must begin with {prefix}")
    return set(values)


def validate(policy, package):
    if set(policy) != {"schemaVersion", "package", "features"}:
        raise ValueError("policy has unknown or missing top-level keys")
    if policy["schemaVersion"] != 1 or policy["package"] != package:
        raise ValueError("policy package or schemaVersion is invalid")
    if not isinstance(policy["features"], dict) or not policy["features"]:
        raise ValueError("policy features must be a non-empty map")
    for name, feature in policy["features"].items():
        if not isinstance(name, str) or not isinstance(feature, dict):
            raise ValueError("feature names and definitions must be maps")
        if set(feature) - {"classification", "requires", "build", "runtime"}:
            raise ValueError(f"feature {name}: unknown key")
        if feature.get("classification") not in CLASSES:
            raise ValueError(f"feature {name}: invalid classification")
        if "requires" in feature and (not isinstance(feature["requires"], list) or not all(isinstance(v, str) for v in feature["requires"])):
            raise ValueError(f"feature {name}: requires must be a string list")
        for key in ("build", "runtime"):
            if key in feature and (not isinstance(feature[key], dict) or not all(isinstance(v, list) and all(isinstance(x, str) for x in v) for v in feature[key].values())):
                raise ValueError(f"feature {name}: {key} must map tools to string lists")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--package", choices=sorted(PACKAGES), required=True)
    parser.add_argument("--device", required=True, help="device manifest JSON with capabilities")
    parser.add_argument("--certification", required=True, help="certification profile JSON with capabilities")
    parser.add_argument("--policy", help="optional deployment-policy JSON with capabilities")
    parser.add_argument("--output", required=True, help="generated/tiny output directory")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    policy_path = root / "tiny" / args.package / "features.yaml"
    try:
        policy = load_yaml(policy_path)
        validate(policy, args.package)
        capability_sources = {
            "device": capability_file(args.device, ""),
            "certification": capability_file(args.certification, "certification."),
        }
        if args.policy:
            capability_sources["policy"] = capability_file(args.policy, "policy.")
        capabilities = set().union(*capability_sources.values())
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        parser.error(str(exc))

    selected, skipped, build, runtime = [], {}, {}, {}
    for name, feature in policy["features"].items():
        classification = feature["classification"]
        needed = feature.get("requires", [])
        enabled = classification in {"required", "upstream-required"} or (classification == "conditional" and set(needed) <= capabilities)
        if enabled:
            selected.append({"id": name, "classification": classification})
            for target, values in feature.get("build", {}).items():
                build.setdefault(target, []).extend(values)
            for target, values in feature.get("runtime", {}).items():
                runtime.setdefault(target, []).extend(values)
        else:
            skipped[name] = {"classification": classification, "missingCapabilities": sorted(set(needed) - capabilities)}
    output = Path(args.output) / args.package / "profile.json"
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps({"schemaVersion": 1, "package": args.package, "capabilitySources": {key: sorted(value) for key, value in capability_sources.items()}, "selected": selected, "skipped": skipped, "build": build, "runtime": runtime}, indent=2, sort_keys=True) + "\n")
    print(output)


if __name__ == "__main__":
    main()
