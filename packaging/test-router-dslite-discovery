#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
files="$root/network/router-dslite/files"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin" "$tmp/etc" "$tmp/run"
cat >"$tmp/bin/getent" <<'MOCK'
#!/usr/bin/env bash
[ "$1" = ahostsv6 ] || exit 1
printf '2001:db8:100::20 STREAM aftr.mec.example\n'
MOCK
cat >"$tmp/bin/ip" <<'MOCK'
#!/usr/bin/env bash
case "$*" in
  *"route get 2001:db8:100::20 oif wan"*) exit 0 ;;
  *) exit 1 ;;
esac
MOCK
chmod +x "$tmp/bin/getent" "$tmp/bin/ip"
env=(env PATH="$tmp/bin:$PATH" ROUTER_DSLITE_RUN="$tmp/run" ROUTER_DSLITE_DISCOVERY_WAN=wan ROUTER_DSLITE_AFTR_NAME_FILE="$tmp/run/aftr-name" ROUTER_DSLITE_AFTR_FILE="$tmp/run/aftr" ROUTER_DSLITE_DISCOVERY_STATUS="$tmp/run/discovery-status")
printf 'aftr.mec.example.\n' >"$tmp/run/aftr-name"
"${env[@]}" "$files/router-dslite-discover" >/dev/null 2>&1
grep -qx '2001:db8:100::20' "$tmp/run/aftr"
grep -qx 'Name=aftr.mec.example' "$tmp/run/discovery-status"
grep -qx 'Source=dhcpv6-option-64' "$tmp/run/discovery-status"
cat >"$tmp/run/aftr-name" <<'EOF_BAD'
not a valid name
EOF_BAD
if "${env[@]}" "$files/router-dslite-discover" >/dev/null 2>&1; then
  echo 'discovery accepted an invalid AFTR name' >&2; exit 1
fi
test ! -e "$tmp/run/aftr"
grep -qx 'Ready=no' "$tmp/run/discovery-status"
# The lifecycle consumes a discovered endpoint when AFTR= is intentionally empty.
cat >"$tmp/etc/router-dslite.conf" <<'EOF_CONF'
Enabled=yes
WAN=wan
AFTR=
Backend=auto
EOF_CONF
cat >"$tmp/bin/ip" <<'MOCK'
#!/usr/bin/env bash
case "$*" in
  *"link show dev wan"*) echo '2: wan: <UP> mtu 1500 state UP' ;;
  *"addr show dev wan scope global"*) echo '2: wan inet6 2001:db8:1::2/64 scope global' ;;
  *) exit 0 ;;
esac
MOCK
chmod +x "$tmp/bin/ip"
printf '2001:db8:100::20\n' >"$tmp/run/aftr"
main_env=(env PATH="$tmp/bin:$PATH" ROUTER_DSLITE_LIB="$tmp/lib" ROUTER_DSLITE_ETC="$tmp/etc" ROUTER_DSLITE_RUN="$tmp/run" ROUTER_DSLITE_CONFIG="$tmp/etc/router-dslite.conf" ROUTER_DSLITE_AFTR_FILE="$tmp/run/aftr")
"${main_env[@]}" "$files/router-dslite" apply >/dev/null 2>&1
grep -qx 'AFTRSource=discovered' "$tmp/run/state"
grep -qx 'AFTR=2001:db8:100::20' "$tmp/run/state"
echo 'router-dslite AFTR discovery validates option-64 FQDN, resolves AAAA, and feeds lifecycle state'
