#!/usr/bin/env python3
"""Print generated build arguments for one package/tool, one per line."""
import json
import sys
from pathlib import Path

if len(sys.argv) != 4:
    raise SystemExit("usage: tiny-build-args PROFILE PACKAGE TOOL")
profile = json.loads(Path(sys.argv[1]).read_text())
if profile.get("schemaVersion") != 1 or profile.get("package") != sys.argv[2]:
    raise SystemExit("tiny profile does not match package or schema v1")
for arg in profile.get("build", {}).get(sys.argv[3], []):
    if not isinstance(arg, str) or not arg or any(char.isspace() for char in arg):
        raise SystemExit("tiny build arguments must be non-empty single shell words")
    print(arg)
