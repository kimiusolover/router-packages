#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
files="$root/network/router-dslite/files"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin" "$tmp/etc" "$tmp/run"
cat >"$tmp/bin/ip" <<'MOCK'
#!/usr/bin/env bash
echo "$*" >>"$ROUTER_DSLITE_IP_LOG"
case "$*" in
  "link show dev wan") echo '2: wan: <UP> mtu 1500 state UP' ;;
  "-br link show dev wan") echo 'wan UP 1500' ;;
  "-6 -o addr show dev wan scope global") echo '2: wan inet6 2001:db8:1::2/64 scope global' ;;
  "-6 tunnel del ds-lite") exit 0 ;;
  "-6 tunnel add ds-lite mode ipip6 remote 2001:db8:100::20 local 2001:db8:1::2 dev wan") exit 0 ;;
  "link set dev ds-lite up") exit 0 ;;
  "addr replace 192.0.0.2/29 dev ds-lite") exit 0 ;;
  "link set dev ds-lite mtu 1460") exit 0 ;;
  *) echo "unexpected ip invocation: $*" >&2; exit 1 ;;
esac
MOCK
chmod +x "$tmp/bin/ip"
cat >"$tmp/etc/router-dslite.conf" <<'EOF_CONF'
Enabled=yes
WAN=wan
AFTR=2001:db8:100::20
Backend=ip6tnl
TunnelInterface=ds-lite
B4Address=192.0.0.2/29
MTU=1460
IPv4DefaultRoute=yes
EOF_CONF
export ROUTER_DSLITE_IP_LOG="$tmp/ip.log"
env=(env PATH="$tmp/bin:$PATH" ROUTER_DSLITE_LIB="$tmp/lib" ROUTER_DSLITE_ETC="$tmp/etc" ROUTER_DSLITE_RUN="$tmp/run" ROUTER_DSLITE_CONFIG="$tmp/etc/router-dslite.conf")
"${env[@]}" "$files/router-dslite" apply >/dev/null 2>&1
grep -qx 'State=ip6tnl-ready' "$tmp/run/state"
grep -qx 'Backend=ip6tnl' "$tmp/run/state"
grep -qx 'B4Address=192.0.0.2/29' "$tmp/run/state"
grep -qx 'MTU=1460' "$tmp/run/state"
grep -qx 'IPv4DefaultRoute=not-configured' "$tmp/run/state"
grep -qx 'AFTR=2001:db8:100::20' "$tmp/run/state"
grep -Fqx -- '-6 tunnel add ds-lite mode ipip6 remote 2001:db8:100::20 local 2001:db8:1::2 dev wan' "$tmp/ip.log"
grep -Fqx -- 'addr replace 192.0.0.2/29 dev ds-lite' "$tmp/ip.log"
grep -Fqx -- 'link set dev ds-lite mtu 1460' "$tmp/ip.log"
! grep -q 'route.*default' "$tmp/ip.log"
"${env[@]}" "$files/router-dslite" stop >/dev/null 2>&1
grep -Fqx -- '-6 tunnel del ds-lite' "$tmp/ip.log"
test ! -e "$tmp/run/state"
echo 'router-dslite ip6tnl creates B4 tunnel state without installing an IPv4 default route'
