#!/usr/bin/env bash
# Static checks intentionally do not download or build unverified inputs.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
components=(systemd hostapd kea unbound nftables jool router-prefix router-nic-discovery router-ipv6-nat router-dslite)
tiny_components=(systemd hostapd kea unbound jool)

for component in "${components[@]}"; do
  recipe="$root/$([ "$component" = systemd ] && printf core || printf network)/$component/recipe"
  test -f "$recipe" || { echo "missing recipe: $component" >&2; exit 1; }
  bash -n "$recipe"
done

for component in "${tiny_components[@]}"; do
  test -s "$root/tiny/$component/features.yaml" || { echo "missing tiny policy: $component" >&2; exit 1; }
done
python3 "$root/packaging/tiny-plan" --help >/dev/null
# Allow exit 1 (usage / no args); any other non-zero is a hard failure.
# Must use || so $? is still the python exit code (if ! ...; then status=$? loses it).
python3 "$root/packaging/tiny-build-args" 2>/dev/null || test $? -eq 1
python3 -m py_compile "$root/packaging/verify-source-lock"
bash -n "$root/packaging/build-ax23v-package"
bash -n "$root/network/router-dslite/files/router-dslite"
bash -n "$root/network/router-dslite/files/router-dslite-discover"
bash -n "$root/network/router-dslite/files/router-dslite-discover-dhcp6"
bash -n "$root/network/router-dslite/files/router-dslite-discover-transix"
bash -n "$root/network/router-network/files/router-network"
bash -n "$root/network/router-prefix/files/prefix-apply"
bash -n "$root/packaging/test-router-dslite-discovery"
bash -n "$root/packaging/test-router-dslite-ip6tnl"
bash "$root/packaging/test-ax23v-entrypoint"
bash "$root/packaging/test-router-prefix"
bash "$root/packaging/test-router-network"
bash "$root/packaging/test-router-nic-discovery"
bash "$root/packaging/test-router-ipv6-nat"
bash "$root/packaging/test-router-dslite-ip6tnl"
bash "$root/packaging/test-router-dslite-discovery"
bash "$root/packaging/test-router-dslite"

for file in \
  "$root/network/hostapd/files/hostapd.service.d/router.conf" \
  "$root/network/kea/files/kea-dhcp4.service.d/router.conf" \
  "$root/network/unbound/files/unbound.service.d/router.conf" \
  "$root/network/nftables/files/nftables.service.d/router.conf" \
  "$root/network/jool/files/jool.service.d/router.conf"; do
  test -s "$file" || { echo "missing integration drop-in: $file" >&2; exit 1; }
  grep -qx 'After=router-network-ready.target' "$file" || {
    echo "drop-in is not ordered after router-network-ready.target: $file" >&2
    exit 1
  }
done

# router-network-ready.target must be packaged through the systemd
# package's network/systemd/files integration directory.
target="$root/network/systemd/files/router-network-ready.target"
test -s "$target" || {
  echo "missing router-network-ready.target: $target" >&2
  exit 1
}
grep -qx 'After=systemd-networkd.service' "$target" || {
  echo "router-network-ready.target must order after systemd-networkd.service" >&2
  exit 1
}
grep -qx 'Wants=systemd-networkd.service' "$target" || {
  echo "router-network-ready.target must want systemd-networkd.service" >&2
  exit 1
}
grep -Fqx 'integration_dir="$root/network/$package/files"' "$root/packaging/build-package" || {
  echo "package builder is missing the integration directory mapping" >&2
  exit 1
}
grep -Fq 'install -Dm644 "$file" "$DESTDIR/usr/lib/systemd/system/$relative"' "$root/packaging/build-package" || {
  echo "package builder is missing systemd integration file installation" >&2
  exit 1
}

echo "router package recipes and service integration are structurally valid"
