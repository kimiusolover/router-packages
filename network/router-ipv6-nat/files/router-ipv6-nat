#!/usr/bin/env bash
# Apply or flush IPv6 NAT66 from router-prefix registry (NATRequired).
set -euo pipefail
lib=${ROUTER_IPV6_NAT_LIB:-/usr/lib/routeros}
etc=${ROUTER_IPV6_NAT_ETC:-/etc/routeros}
run_prefix=${ROUTER_PREFIX_RUN:-/run/routeros/prefix}
run_nat=${ROUTER_IPV6_NAT_RUN:-/run/routeros/nat6}
config=${ROUTER_IPV6_NAT_CONFIG:-$etc/router-ipv6-nat.conf}
[ -r "$config" ] || config=$lib/router-ipv6-nat.conf
value() { sed -n "s/^$1=//p" "$2" 2>/dev/null | tail -n1; }
conf() { value "$1" "$config" || true; }

active=$run_prefix/active
nft_file=$run_nat/routeros-nat6.nft
table=$(conf Table); table=${table:-routeros_nat6}
wan=$(conf WAN); wan=${wan:-enp2s0}
enabled=$(conf Enabled); enabled=${enabled:-yes}

flush() {
  if command -v nft >/dev/null 2>&1; then
    nft delete table ip6 "$table" 2>/dev/null || true
  fi
  rm -f "$nft_file"
}

apply() {
  mkdir -p "$run_nat"
  if [ "$enabled" != yes ]; then
    echo "IPv6 NAT disabled in config" >&2
    flush
    return 0
  fi
  [ -r "$active" ] || { echo "missing $active" >&2; return 1; }
  local source prefix nat
  source=$(value Source "$active" || true)
  prefix=$(value Prefix "$active" || true)
  nat=$(value NATRequired "$active" || true)
  [ -n "$prefix" ] || { echo "no Prefix in active" >&2; return 1; }

  if [ "$nat" != yes ]; then
    echo "NATRequired=${nat:-unset} (Source=$source); NAT66 off" >&2
    flush
    return 0
  fi

  umask 077
  cat >"$nft_file.new.$$" <<NFT
# Generated by router-ipv6-nat — do not edit
# Source=$source Prefix=$prefix NATRequired=$nat
table ip6 $table {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        ip6 saddr $prefix oifname "$wan" counter masquerade
    }
}
NFT
  mv -f "$nft_file.new.$$" "$nft_file"

  if ! command -v nft >/dev/null 2>&1; then
    echo "nft not found; wrote $nft_file only" >&2
    return 0
  fi
  nft delete table ip6 "$table" 2>/dev/null || true
  nft -f "$nft_file"
  echo "applied NAT66 $prefix → $wan (table $table)" >&2
}

case ${1:-} in
  apply|ensure) apply ;;
  flush|stop) flush ;;
  *) echo "usage: router-ipv6-nat {apply|ensure|flush|stop}" >&2; exit 64 ;;
esac
