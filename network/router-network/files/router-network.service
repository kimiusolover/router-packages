[Unit]
Description=RouterOS Network Configuration
After=router-nic-discovery.service
Wants=router-nic-discovery.service
Before=prefix-manager.service
# prefix-map is generated by router-network and consumed by prefix-apply.

[Service]
Type=oneshot
ExecStart=/usr/lib/routeros/router-network apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
