#!/usr/bin/env bash
# DS-Lite control: validate WAN IPv6/AFTR and manage the selected lifecycle backend.
# ip6tnl creates only the IPv4-in-IPv6 B4 tunnel; IPv4 routes are a later stage.
set -euo pipefail
lib=${ROUTER_DSLITE_LIB:-/usr/lib/routeros}
etc=${ROUTER_DSLITE_ETC:-/etc/routeros}
run=${ROUTER_DSLITE_RUN:-/run/routeros/dslite}
config=${ROUTER_DSLITE_CONFIG:-$etc/router-dslite.conf}
[ -r "$config" ] || config=$lib/router-dslite.conf
value() { sed -n "s/^$1=//p" "$2" 2>/dev/null | tail -n1; }
conf() { value "$1" "$config" || true; }
state_file=$run/state; status_file=$run/status
enabled=$(conf Enabled); enabled=${enabled:-yes}
wan=$(conf WAN); wan=${wan:-enp2s0}
aftr=$(conf AFTR); aftr=${aftr:-}
aftr_file=${ROUTER_DSLITE_AFTR_FILE:-$run/aftr}
aftr_source=auto
if [ -n "$aftr" ] && [ "$aftr" != unset ]; then
  aftr_source=explicit
elif [ -r "$aftr_file" ]; then
  aftr=$(tr -d '[:space:]' <"$aftr_file")
  [ -n "$aftr" ] && aftr_source=discovered
fi
local_addr=$(conf LocalAddress); local_addr=${local_addr:-}
tun=$(conf TunnelInterface); tun=${tun:-ds-lite}
backend=$(conf Backend); backend=${backend:-auto}
ipv4_default=$(conf IPv4DefaultRoute); ipv4_default=${ipv4_default:-yes}
mtu=$(conf MTU); mtu=${mtu:-}; mss=$(conf MSSClamp); mss=${mss:-}
b4_address=$(conf B4Address); b4_address=${b4_address:-192.0.0.2/29}
route_metric=$(conf IPv4RouteMetric); route_metric=${route_metric:-50}
auto_discovery_note="AFTR discovery is pending (DHCPv6 option 64)"
write_status() {
  mkdir -p "$run"; umask 077
  { echo "Enabled=$enabled"; echo "WAN=$wan"; echo "AFTR=$aftr"
    echo "AFTRSource=$aftr_source"
    echo "LocalAddress=${local_addr:-}"; echo "TunnelInterface=$tun"; echo "Backend=$backend"
    echo "Ready=$1"; echo "Message=$2"
    echo "Updated=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  } >"$status_file.new.$$"
  mv -f "$status_file.new.$$" "$status_file"
}
primary_wan_gua() {
  local iface=$1
  ip -6 -o addr show dev "$iface" scope global 2>/dev/null | awk '
    { split($4, a, "/"); addr = a[1]
      if (addr ~ /^fe80:/ || addr ~ /^fd/ || addr ~ /^fc/) next
      print addr; exit }'
}
wan_ipv6_ok() {
  local iface=$1
  ip link show dev "$iface" >/dev/null 2>&1 || return 1
  ip -br link show dev "$iface" 2>/dev/null | grep -q 'UP' || return 1
  [ -n "$(primary_wan_gua "$iface")" ]
}
aftr_configured() { [ -n "$aftr" ] && [ "$aftr" != unset ]; }
validate_backend() {
  case "$backend" in auto|stub|ip6tnl|jool) return 0;;
    *) write_status no "unknown backend: $backend"; echo "unknown Backend=$backend (use auto|stub|ip6tnl|jool)" >&2; return 1;; esac
}
check_prereqs() {
  if [ "$enabled" != yes ]; then write_status no "disabled in config"; echo "DS-Lite disabled in config" >&2; return 1; fi
  validate_backend || return 1
  if ! wan_ipv6_ok "$wan"; then
    write_status no "WAN $wan has no global IPv6 address"; echo "WAN $wan: need interface UP with GUA (RA)" >&2; return 1
  fi
  [ -n "$local_addr" ] || local_addr=$(primary_wan_gua "$wan")
  if ! aftr_configured; then
    write_status no "AFTR is optional; $auto_discovery_note"
    echo "AFTR is optional; $auto_discovery_note" >&2; return 1
  fi
  write_status yes "prerequisites ok (backend=$backend, AFTR=$aftr_source)"
}
apply_stub() {
  mkdir -p "$run"; umask 077
  { echo "State=stub-ready"; echo "WAN=$wan"; echo "AFTR=$aftr"; echo "AFTRSource=$aftr_source"
    echo "LocalAddress=$local_addr"; echo "TunnelInterface=$tun"; echo "RequestedBackend=$backend"
    echo "Backend=stub"; echo "IPv4DefaultRoute=$ipv4_default"; echo "MTU=${mtu:-}"; echo "MSSClamp=${mss:-}"
    echo "Note=tunnel not created; ip6tnl and IPv4 route are separate lifecycle stages"
  } >"$state_file.new.$$"
  mv -f "$state_file.new.$$" "$state_file"
  echo "DS-Lite stub ready: WAN=$wan AFTR=$aftr Local=$local_addr (no tunnel yet)" >&2
}
apply_ip6tnl() {
  command -v ip >/dev/null || {
    write_status no "ip command is missing for ip6tnl backend"
    return 1
  }
  [ -n "$local_addr" ] || {
    write_status no "WAN GUA is missing for ip6tnl backend"
    return 1
  }
  # Re-apply is idempotent: remove only the tunnel and state owned by this package.
  rm -f "$state_file"
  ip -6 tunnel del "$tun" 2>/dev/null || true
  if ! ip -6 tunnel add "$tun" mode ipip6 remote "$aftr" local "$local_addr" dev "$wan"; then
    write_status no "failed to create ip6tnl tunnel"
    return 1
  fi
  if ! ip link set dev "$tun" up || ! ip addr replace "$b4_address" dev "$tun"; then
    ip -6 tunnel del "$tun" 2>/dev/null || true
    write_status no "failed to configure ip6tnl tunnel"
    return 1
  fi
  if [ -n "$mtu" ] && ! ip link set dev "$tun" mtu "$mtu"; then
    ip -6 tunnel del "$tun" 2>/dev/null || true
    write_status no "failed to set ip6tnl MTU"
    return 1
  fi
  case "$route_metric" in
    ''|*[!0-9]*)
      ip -6 tunnel del "$tun" 2>/dev/null || true
      write_status no "IPv4RouteMetric must be a non-negative integer"
      return 1
      ;;
  esac
  route_state=not-configured
  if [ "$ipv4_default" = yes ]; then
    # Use add, not replace: existing defaults remain intact and metric selects
    # the DS-Lite route only when it is the preferred eligible route.
    if ! ip -4 route add default dev "$tun" metric "$route_metric"; then
      ip -6 tunnel del "$tun" 2>/dev/null || true
      write_status no "failed to add IPv4 default route"
      return 1
    fi
    route_state=configured
  elif [ "$ipv4_default" != no ]; then
    ip -6 tunnel del "$tun" 2>/dev/null || true
    write_status no "IPv4DefaultRoute must be yes or no"
    return 1
  fi
  mkdir -p "$run"; umask 077
  { echo "State=ready"; echo "WAN=$wan"; echo "AFTR=$aftr"; echo "AFTRSource=$aftr_source"
    echo "LocalAddress=$local_addr"; echo "TunnelInterface=$tun"; echo "RequestedBackend=$backend"
    echo "Backend=ip6tnl"; echo "B4Address=$b4_address"; echo "MTU=${mtu:-kernel-default}"
    echo "IPv4DefaultRoute=$route_state"; echo "IPv4RouteMetric=$route_metric"
    echo "Note=IPv4 default route uses add and a dedicated metric"
  } >"$state_file.new.$$"
  mv -f "$state_file.new.$$" "$state_file"
  echo "DS-Lite ip6tnl ready: WAN=$wan AFTR=$aftr Local=$local_addr B4=$b4_address route=$route_state" >&2
}
apply_jool() { echo "Backend=jool is not implemented in this skeleton" >&2; write_status no "jool backend not implemented"; return 1; }
apply() {
  check_prereqs || return 1
  case "$backend" in auto|stub) apply_stub;; ip6tnl) apply_ip6tnl;; jool) apply_jool;; esac
}
stop() {
  if [ -r "$state_file" ] && grep -qx 'IPv4DefaultRoute=configured' "$state_file" && command -v ip >/dev/null; then
    saved_metric=$(sed -n 's/^IPv4RouteMetric=//p' "$state_file" | tail -n1)
    ip -4 route del default dev "$tun" metric "${saved_metric:-$route_metric}" 2>/dev/null || true
  fi
  if { [ "$backend" = ip6tnl ] || { [ -r "$state_file" ] && grep -qx 'Backend=ip6tnl' "$state_file"; }; } && command -v ip >/dev/null; then
    ip -6 tunnel del "$tun" 2>/dev/null || true
  fi
  rm -f "$state_file"
  write_status no "stopped"
  echo "DS-Lite stopped" >&2
}
status() {
  if [ -r "$status_file" ]; then cat "$status_file"; else echo "Ready=unknown"; echo "Message=no status yet; run apply"; fi
  if [ -r "$state_file" ]; then echo "---"; cat "$state_file"; fi
}
case ${1:-} in
  apply|ensure) apply;; stop|flush) stop;;
  status|check) if check_prereqs; then status; exit 0; else status; exit 1; fi;;
  *) echo "usage: router-dslite {apply|ensure|stop|flush|status|check}" >&2; exit 64;;
esac
