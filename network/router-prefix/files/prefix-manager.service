[Unit]
Description=RouterOS IPv6 Prefix Manager
Requires=router-network.service
Wants=network-online.target
After=network-online.target router-network.service
Before=router-network-ready.target
# PD lifecycle watcher
Wants=router-prefix-delegated.path

[Service]
Type=oneshot
ExecStart=/usr/lib/routeros/prefix-manager ensure
ExecStart=/usr/lib/routeros/prefix-apply apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
