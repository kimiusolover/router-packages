#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob extglob
readonly config=${ROUTER_NIC_DISCOVERY_CONFIG:-/etc/routeros/nic-discovery.conf}
readonly run_dir=${ROUTER_NIC_DISCOVERY_RUN:-/run/routeros}
readonly sys_class_net=${ROUTER_NIC_DISCOVERY_SYS_CLASS_NET:-/sys/class/net}
fail() { printf 'router-nic-discovery: %s\n' "$*" >&2; exit 1; }
[[ -d $sys_class_net ]] || fail "network device directory not found: $sys_class_net"

ethernet_only=yes; exclude_wireless=yes; allow_vlan_lan=yes
if [[ -r $config ]]; then
  section=
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}; line=${line%%;*}; line=${line##+([[:space:]])}; line=${line%%+([[:space:]])}
    [[ -z $line ]] && continue
    if [[ $line =~ ^\[([A-Za-z]+)\]$ ]]; then section=${BASH_REMATCH[1]}; continue; fi
    [[ $line == *=* ]] || fail "invalid configuration line: $line"
    key=${line%%=*}; value=${line#*=}; key=${key//[[:space:]]/}; value=${value//[[:space:]]/}
    [[ $section == Discovery ]] || fail "unsupported section: $section"
    case $key in
      EthernetOnly) ethernet_only=$value ;;
      ExcludeWireless) exclude_wireless=$value ;;
      AllowVlanLan) allow_vlan_lan=$value ;;
      *) fail "unsupported setting: $key" ;;
    esac
  done <"$config"
fi
for value in "$ethernet_only" "$exclude_wireless" "$allow_vlan_lan"; do
  [[ $value == yes || $value == no ]] || fail 'policy values must be yes or no'
done

declare -A seen_path=()
declare -a devices=() ethernet_paths=()
for sys in "$sys_class_net"/*; do
  name=${sys##*/}
  [[ $name == lo || ! -e $sys/device ]] && continue
  [[ $exclude_wireless == yes && ( $name == wl* || -d $sys/wireless ) ]] && continue
  props=$(udevadm info --query=property --path="$sys") || fail "udevadm failed for $name"
  path=$(sed -n 's/^ID_PATH=//p' <<<"$props" | head -n1)
  driver=$(sed -n 's/^ID_NET_DRIVER=//p' <<<"$props" | head -n1)
  vendor=$(sed -n 's/^ID_VENDOR_ID=//p' <<<"$props" | head -n1); vendor=${vendor#0x}
  device=$(sed -n 's/^ID_MODEL_ID=//p' <<<"$props" | head -n1); device=${device#0x}
  [[ $path =~ ^pci-[[:alnum:]_.:-]+$ ]] || continue
  [[ -z ${seen_path[$path]+seen} ]] || fail "duplicate PCI path detected: $path"
  seen_path[$path]=1
  type=ethernet
  [[ -d $sys/wireless ]] && type=wireless
  [[ $ethernet_only == yes && $type != ethernet ]] && continue
  devices+=("$path|$name|${driver:-unknown}|${vendor:-unknown}|${device:-unknown}|$type")
  [[ $type == ethernet ]] && ethernet_paths+=("$path")
done
((${#ethernet_paths[@]} > 0)) || fail 'no PCI Ethernet interfaces found'

wan_path=; lan_path=; lan_mode=none
if ((${#ethernet_paths[@]} == 1)); then
  wan_path=${ethernet_paths[0]}
  if [[ $allow_vlan_lan == yes ]]; then lan_path=$wan_path; lan_mode=vlan; fi
fi
mkdir -p "$run_dir"
tmp=$(mktemp -d "$run_dir/.nic-discovery.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
{
  echo '[Discovery]'; echo 'Version=1'
  for record in "${devices[@]}"; do
    IFS='|' read -r path name driver vendor device type <<<"$record"
    role=unassigned
    [[ $path == "$wan_path" ]] && role=wan
    [[ $path == "$lan_path" && $lan_mode == vlan ]] && role=wan-lan-parent
    printf 'Device=%s,%s,%s,%s,%s,%s,%s\n' "$role" "$path" "$name" "$driver" "$vendor" "$device" "$type"
  done
  if [[ -n $wan_path ]]; then
    wan_record=
    for record in "${devices[@]}"; do IFS='|' read -r path name _ <<<"$record"; [[ $path == "$wan_path" ]] && { wan_record=$record; break; }; done
    IFS='|' read -r _ wan_name _ <<<"$wan_record"
    printf '\n[WAN]\nPath=%s\nInterface=%s\nRole=wan\n' "$wan_path" "$wan_name"
    if [[ $lan_mode == vlan ]]; then printf '\n[LAN]\nRole=lan\nMode=vlan\nParentPath=%s\nParentInterface=%s\n' "$wan_path" "$wan_name"; fi
  else
    echo; echo '[WAN]'; echo 'Role=unassigned'
    echo; echo '[LAN]'; echo 'Role=unassigned'
  fi
  for record in "${devices[@]}"; do
    IFS='|' read -r path name driver vendor device type <<<"$record"
    if [[ $type == wireless ]]; then printf '\n[Wireless]\nPath=%s\nInterface=%s\nDriver=%s\nVendor=%s\nDevice=%s\n' "$path" "$name" "$driver" "$vendor" "$device"; fi
  done
} >"$tmp/result"
chmod 0644 "$tmp/result"
mv -f "$tmp/result" "$run_dir/nic-discovery.conf"
